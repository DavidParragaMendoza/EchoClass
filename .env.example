# ============================================================
# EchoClass — Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# ----------------------------------------------------------
# RunPod — Configuración del pod remoto
# Obtener en: RunPod Dashboard → tu pod → Connect → HTTP Service
# ----------------------------------------------------------

# URL pública del pod (copiar desde RunPod Dashboard)
# Formato: https://XXXXXXXX-8000.proxy.runpod.net
RUNPOD_POD_URL=https://REEMPLAZAR-8000.proxy.runpod.net

# API Key del pod (dejar vacío si no configuraste autenticación en RunPod)
RUNPOD_API_KEY=

# ----------------------------------------------------------
# Whisper — Configuración de transcripción
# Estos valores se aplican DENTRO del pod
# ----------------------------------------------------------

# Modelo Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=large-v3

# Dispositivo: cuda (GPU) | cpu
WHISPER_DEVICE=cuda

# Tipo de computación:
#   GPU → float16 (recomendado)
#   CPU → int8
WHISPER_COMPUTE_TYPE=float16

# Idioma por defecto de transcripción
WHISPER_LANGUAGE=es

# ----------------------------------------------------------
# Ollama — Configuración del modelo de resúmenes
# Estos valores se aplican DENTRO del pod
# ----------------------------------------------------------

# Modelo LLM: qwen2.5:7b | qwen2.5:3b | llama3.1:8b
OLLAMA_MODEL=qwen2.5:7b

# URL de Ollama (dentro del pod es localhost — NO cambiar)
OLLAMA_URL=http://localhost:11434

# ----------------------------------------------------------
# Servidor — Configuración del servidor FastAPI
# ----------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
